{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "buildCommand": "npm run build:vercel",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "vite",
  "outputDirectory": "dist",
  "build": {
    "env": {
      "ROLLUP_SKIP_PLATFORM_SPECIFIC_BINARIES": "true",
      "VITE_PLUGIN_REACT_SWC": "false"
    }
  }
}